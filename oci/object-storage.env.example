# Copy to a private local file. No shell quotes; kubectl reads literal key=value.
OBJECT_STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com/<bucket>/clickhouse-clean/
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_ACCESS_KEY=<customer-secret-key-access-key>
OBJECT_STORAGE_SECRET_KEY=<customer-secret-key-secret-key>
